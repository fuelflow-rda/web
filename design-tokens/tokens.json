      },
      "pay-momo": {
        "light": "#A9821A",
        "dark": "#E3C25A"
      },
      "chart-1": {
        "light": "#1A422F",
        "dark": "#F3EBD6",
        "$description": "Categorical series 1, Forest. Dark: Cream, as primary flips."
      },
      "chart-2": {
        "light": "#3F9A76",
        "dark": "#5DBB93",
        "$description": "Jade"
      },
      "chart-3": {
        "light": "#3B6B8F",
