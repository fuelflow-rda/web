    "fixed": {
      "$description": "The same in both themes. The sidebar is always Night; the inverse band is the landing page's Forest section.",
      "sidebar-bg": "#02110C",
      "sidebar-surface": "#0A1F17",
      "sidebar-selected": "#11291F",
      "sidebar-line": "#1E3B30",
      "sidebar-text": "#F3EBD6",
      "sidebar-text-secondary": "#B8BEB1",
      "sidebar-text-muted": "#8B958B",
      "sidebar-indicator": "#C8B68E",
