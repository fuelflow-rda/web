        "light": "#FAF6EC",
        "dark": "#02110C",
        "$description": "Page background"
      },
      "surface": {
        "light": "#FFFDF8",
        "dark": "#0A1F17",
        "$description": "Cards, panels, inputs"
      },
      "surface-muted": {
