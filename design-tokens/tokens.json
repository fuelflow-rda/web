        "dark": "#8B958B"
      },
      "primary": {
        "light": "#1A422F",
        "dark": "#F3EBD6",
        "$description": "Primary button fill, selected states. Flips to Cream in dark mode."
      },
      "on-primary": {
        "light": "#F3EBD6",
        "dark": "#02110C"
      },
      "primary-hover": {
